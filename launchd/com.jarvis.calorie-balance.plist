<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jarvis.calorie-balance</string>
    <!-- The evening calorie balance to the WhatsApp group "Nährwerte Jarvis",
         22:00 daily. launchd runs a missed time on wake; the script itself
         sends only between 22:00 and midnight and at most once a day.
         Runs from ~/.hermes/services: launchd has no TCC access to ~/Documents.
         No RunAtLoad — loading the job must not send anything. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/marlon/.local/bin/python3.11</string>
        <string>/Users/marlon/.hermes/services/jarvis-calorie-balance.py</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>22</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <!-- launchd has only the system PATH; `hermes` is a shell script that
         needs its own bin directory. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/marlon/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/marlon/.hermes/logs/jarvis-calorie-balance.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/marlon/.hermes/logs/jarvis-calorie-balance.error.log</string>
</dict>
</plist>
