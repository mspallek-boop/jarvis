<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jarvis.bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/marlon/.local/bin/python3.11</string>
        <string>/Users/marlon/.hermes/services/jarvis_bridge.py</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8770</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Interactive, not Background. macOS throttles a Background job's CPU
         and its children inherit it, and speech synthesis is a child process:
         the same sentence took 1.2s from a terminal and 9.2s through the
         throttled bridge. This job serves a live conversation. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>WorkingDirectory</key>
    <string>/Users/marlon/.hermes</string>
    <key>StandardOutPath</key>
    <string>/Users/marlon/.hermes/logs/jarvis-bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/marlon/.hermes/logs/jarvis-bridge.error.log</string>
</dict>
</plist>
