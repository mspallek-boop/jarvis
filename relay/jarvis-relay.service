[Unit]
Description=JARVIS Wake-on-LAN relay
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/jarvis
EnvironmentFile=/etc/jarvis-relay.env
ExecStart=/usr/bin/python3 /opt/jarvis/relay/jarvis_relay.py --host 0.0.0.0 --port 8787
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
